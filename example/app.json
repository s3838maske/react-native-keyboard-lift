{
  "expo": {
    "name": "Keyboard Lift Example",
    "slug": "react-native-keyboard-lift-example",
    "version": "1.0.0",
    "orientation": "default",
    "userInterfaceStyle": "light",
    "newArchEnabled": true,
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.example.keyboardlift"
    },
    "android": {
      "package": "com.example.keyboardlift",
      "edgeToEdgeEnabled": true,
      "softwareKeyboardLayoutMode": "resize"
    }
  }
}
