{
  "name": "react-native-smart-keyboard",
  "version": "0.1.0",
  "description": "Zero-configuration React Native keyboard management that keeps the focused input visible on iOS and Android. No native code, no runtime dependencies.",
  "keywords": [
    "react-native",
    "keyboard",
    "keyboard-avoiding-view",
    "keyboard-aware",
    "keyboard-aware-scroll-view",
    "textinput",
    "scrollview",
    "flatlist",
    "edge-to-edge",
    "safe-area",
    "ios",
    "android",
    "expo",
    "typescript"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/your-org/react-native-smart-keyboard.git"
  },
  "homepage": "https://github.com/your-org/react-native-smart-keyboard#readme",
  "bugs": {
    "url": "https://github.com/your-org/react-native-smart-keyboard/issues"
  },
  "license": "MIT",
  "author": "",
  "main": "./lib/commonjs/index.js",
  "module": "./lib/module/index.js",
  "types": "./lib/typescript/index.d.ts",
  "react-native": "src/index.ts",
  "source": "src/index.ts",
  "files": [
    "src",
    "lib",
    "README.md",
    "CHANGELOG.md",
    "LICENSE",
    "!**/__tests__",
    "!**/__fixtures__",
    "!**/__mocks__",
    "!**/.*"
  ],
  "sideEffects": false,
  "scripts": {
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "test": "jest",
    "test:watch": "jest --watch",
    "test:coverage": "jest --coverage",
    "clean": "rm -rf lib",
    "build": "bob build",
    "prepare": "bob build"
  },
  "peerDependencies": {
    "react": ">=19.0.0",
    "react-native": ">=0.85.0",
    "react-native-safe-area-context": ">=4.0.0"
  },
  "peerDependenciesMeta": {
    "react-native-safe-area-context": {
      "optional": true
    }
  },
  "devDependencies": {
    "@react-native/babel-preset": "0.85.3",
    "@react-native/jest-preset": "0.85.3",
    "@testing-library/react-native": "^14.0.1",
    "@types/jest": "^29.5.14",
    "@types/react": "^19.1.1",
    "eslint": "^9.30.0",
    "eslint-plugin-react-hooks": "^5.2.0",
    "jest": "^29.7.0",
    "react": "19.2.3",
    "react-native": "0.85.3",
    "react-native-builder-bob": "^0.43.0",
    "react-native-safe-area-context": "^5.9.0",
    "test-renderer": "^1.2.0",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.20.0"
  },
  "engines": {
    "node": ">=20"
  },
  "react-native-builder-bob": {
    "source": "src",
    "output": "lib",
    "targets": [
      "commonjs",
      "module",
      [
        "typescript",
        {
          "project": "tsconfig.build.json"
        }
      ]
    ]
  }
}
